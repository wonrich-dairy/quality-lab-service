{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },

  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "Topics": {
      "BatchDeterminations": "wonrich.quality-lab.batch-determinations.v1",
      "StageEvents": "wonrich.processing.stage-events.v1",
      "DeadLetter": "wonrich.dlq.quality-lab-stage-events.v1"
    },
    "ConsumerGroups": {
      "StageEvents": "quality-lab-stage-events"
    },
    "StageEventListener": {
      "Enabled": true
    }
  },

  "AllowedHosts": "*"
}