QLS_DB_CONNECTION=Server=<host>.mysql.database.azure.com;Port=3306;Database=quality_lab;User=<user>;Password=<password>;SslMode=Required;

# Kafka (shared broker from wonrich-infra). Defaults work locally.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=Plaintext
# Hosted broker only (e.g. Event Hubs): SaslSsl / Plain / $ConnectionString / <connection string>
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
