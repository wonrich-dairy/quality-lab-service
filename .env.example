QLS_DB_CONNECTION=Server=<new-server>.mysql.database.azure.com;Port=3306;Database=quality_lab;User=qls_app;Password=<QLS_PASS>;SslMode=Required;

# Kafka - the broker runs in wonrich-infra on the shared wonrich-net network.
# These defaults work for local development.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=Plaintext
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Staging: the shared Kafka VM (wonrich-infra/azure/kafka-vm), SASL_PLAINTEXT on 9094.
# The password is shared privately - never commit it.
# KAFKA_BOOTSTRAP_SERVERS=<vm-dns>:9094
# KAFKA_SECURITY_PROTOCOL=SaslPlaintext
# KAFKA_SASL_MECHANISM=Plain
# KAFKA_SASL_USERNAME=wonrich
# KAFKA_SASL_PASSWORD=
